load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library")

go_library(
    name = "parser-helper_lib",
    srcs = ["main.go"],
    importpath = "github.com/cockroachdb/cockroach/pkg/cmd/parser-helper",
    visibility = ["//visibility:private"],
    deps = [
        "//pkg/sql/parser:parser",
    ],
)

go_binary(
    name = "parser-helper",
    embed = [":parser-helper_lib"],
    exec_properties = {"Pool": "large"},
    visibility = ["//visibility:public"],
)